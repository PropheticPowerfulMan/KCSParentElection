{
  "id": "kcs-parent-election",
  "name": "KCS Parent Election",
  "short_name": "KCS Election",
  "description": "Plateforme officielle bilingue et sécurisée de l’élection des parents KCS",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "/login/",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#cdd8df",
  "theme_color": "#285a7b",
  "categories": [
    "education",
    "utilities"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "kcs-election-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "kcs-election-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "kcs-election-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Voter",
      "short_name": "Voter",
      "url": "./login/",
      "icons": [
        {
          "src": "kcs-election-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Résultats officiels",
      "short_name": "Résultats",
      "url": "./results/",
      "icons": [
        {
          "src": "kcs-election-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest.webmanifest",
      "id": "https://kcsparentelection.kinshasachristianschool.org/kcs-parent-election"
    }
  ]
}
